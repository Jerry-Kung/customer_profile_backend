# Copy to ".env" in the project root. load_config() auto-loads .env (python-dotenv).
# app
APP_ENV=local
LOG_LEVEL=INFO
# HTTP API bind (microservice / container)
API_HOST=0.0.0.0
API_PORT=8000
# docker compose: host port mapped to container 8000 (see docs/deploy-and-run.md)
HOST_API_PORT=8000

# workflow platform — pick the Agent platform the worker calls.
#   dify     : original Dify workflow (uses DIFY_* vars below)
#   qingtian : DFMC self-built QingTian platform (uses QINGTIAN_* vars below)
#   local    : local Python profile service (uses LOCAL_* vars below)
WORKFLOW_PLATFORM=dify

# Which platform serves invitation_strategy. invitation_strategy is NOT migrated to the
# local service, so with WORKFLOW_PLATFORM=local this must be set explicitly to dify or
# qingtian. When WORKFLOW_PLATFORM is dify or qingtian it defaults to that same value.
# INVITATION_STRATEGY_PLATFORM=dify

# dify
DIFY_BASE_URL=http://118.145.238.55
DIFY_RUN_URL=http://118.145.238.55/v1/workflows/run
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxx
# Optional: separate keys per work_env for the customer_profile workflow.
# If unset, both fall back to DIFY_API_KEY above.
DIFY_API_KEY_TEST=
DIFY_API_KEY_PRODUCTION=
# Required for the invitation_strategy task type (single key; work_env handled inside the Dify workflow itself).
DIFY_INVITATION_STRATEGY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_USER_ID=klh
DIFY_IMAGE_MODE=file_id
DIFY_STREAM_INIT_TIMEOUT_MS=30000
DIFY_POLL_INTERVAL_MS=2000
DIFY_POLL_TIMEOUT_MS=900000

# qingtian (only required when WORKFLOW_PLATFORM=qingtian)
# Base URL must include the /api/proxy/api/v1 prefix; client appends /run_app_workflow and /query_run_app_process.
QINGTIAN_BASE_URL=https://qingtian.dfmc.com.cn/api/proxy/api/v1
QINGTIAN_API_KEY_TEST=
QINGTIAN_API_KEY_PRODUCTION=
QINGTIAN_INVITATION_STRATEGY_API_KEY=
QINGTIAN_USER_ID=klh
QINGTIAN_POLL_INTERVAL_MS=2000
QINGTIAN_POLL_TIMEOUT_MS=2400000

# local Python profile service (only required when WORKFLOW_PLATFORM=local).
# LOCAL_BASE_URL must point at the host the service is deployed on — it is frequently NOT
# this machine, so never reduce it to 127.0.0.1. Include scheme, no trailing slash needed.
# The client POSTs to {LOCAL_BASE_URL}{LOCAL_TASK_PATH}.
LOCAL_BASE_URL=http://10.81.67.210:8099
LOCAL_TASK_PATH=/api/v1/tasks
# Sent as the X-API-Key header on submission (the service's INBOUND_API_KEY).
LOCAL_API_KEY=
# Shared secret the local service must present on its writeback to us. Also acts as the
# on/off switch for the writeback endpoint: left empty, the endpoint answers 503.
LOCAL_CALLBACK_API_KEY=
# Path we expose for the local service's writeback. Change it only if that side is
# configured to a different path.
LOCAL_CALLBACK_PATH=/api/v1/remote/callback/update-profile
# Submission only persists the task, so this timeout is short — the result arrives by
# writeback ~21 minutes later, not on this response.
LOCAL_SUBMIT_TIMEOUT_MS=10000
# Retries for the documented retryable statuses only (429 and 500).
LOCAL_SUBMIT_MAX_RETRIES=3
# Fallback wait when a 429 omits Retry-After.
LOCAL_RETRY_AFTER_DEFAULT_SECONDS=30

# worker: concurrency PER TASK TYPE — customer_profile and invitation_strategy each get
# their own pool of this many threads (total worker threads = task types x this value).
WORKER_CONCURRENCY=8
# Max number of queued (waiting) tasks; submissions beyond this are rejected with a queue-full error.
TASK_QUEUE_MAX_WAITING=500

# mysql
MYSQL_HOST=118.145.238.55
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
